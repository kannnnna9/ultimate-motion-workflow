{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kannnnna9/ultimate-motion-workflow/templates/episode/schema/naskah.schema.json",
  "title": "Episode script (naskah)",
  "description": "Naskah narasi per beat. Beat adalah unit editorial; caption per kata diturunkan dari VO, bukan ditulis tangan di sini.",
  "type": "object",
  "required": ["version", "episode", "language", "voice", "beats"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "episode": { "type": "string", "minLength": 1 },
    "language": { "const": "id" },
    "voice": {
      "type": "object",
      "required": ["engine", "name"],
      "additionalProperties": false,
      "properties": {
        "engine": { "enum": ["edge", "external"] },
        "name": { "type": "string", "minLength": 1, "examples": ["id-ID-GadisNeural"] },
        "rate": { "type": "string", "pattern": "^[+-]\\d+%$", "default": "+0%" },
        "pitch": { "type": "string", "pattern": "^[+-]\\d+Hz$" }
      }
    },
    "target_duration_s": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number", "exclusiveMinimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 2,
      "description": "Minimal dua beat untuk v1: demo wajib dua adegan.",
      "items": {
        "type": "object",
        "required": ["id", "narration", "purpose"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^b[0-9]{3}$", "description": "b001, b002, ... berurutan" },
          "narration": { "type": "string", "minLength": 1, "description": "Teks VO persis yang diucapkan. Satu ide per beat." },
          "purpose": { "type": "string", "minLength": 1, "description": "Fungsi beat ini: hook, konteks, bukti, payoff." },
          "on_screen_text": { "type": "string", "description": "Teks yang tampil di layar untuk beat ini, boleh berbeda dari narasi." },
          "fact_refs": {
            "type": "array",
            "description": "ID di naskah.sources yang menopang klaim beat ini.",
            "items": { "type": "string" },
            "default": []
          },
          "estimated_s": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Kartu sumber yang wajib tampil di akhir. Klaim tanpa sumber tidak boleh masuk narasi.",
      "items": {
        "type": "object",
        "required": ["id", "title", "url"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" },
          "publisher": { "type": "string" },
          "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      },
      "default": []
    }
  }
}
