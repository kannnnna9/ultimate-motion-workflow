{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kannnnna9/ultimate-motion-workflow/templates/episode/schema/brand.schema.json",
  "title": "Episode brand sheet",
  "description": "Sumber kebenaran visual untuk satu episode. Semua warna, tipografi, dan aturan terukur di sini; komposisi mengambil nilai ini, tidak menebak.",
  "type": "object",
  "required": ["version", "episode", "style_id", "canvas", "palette", "typography", "safe_area", "banned"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "episode": { "type": "string", "minLength": 1, "description": "Slug episode, sama dengan nama folder di templates/episode/episodes/<slug>/" },
    "style_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "description": "ID preset di styles/registry.json" },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "fps", "codec", "audio_codec"],
      "additionalProperties": false,
      "properties": {
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "fps": { "const": 30 },
        "codec": { "const": "h264" },
        "audio_codec": { "const": "aac" },
        "pixel_aspect": { "const": "1:1" },
        "color_space": { "type": "string", "default": "bt709" }
      }
    },
    "palette": {
      "type": "object",
      "description": "Peran warna, bukan nama merek. Setiap nilai hex 6 digit.",
      "required": ["ground", "ink", "accent"],
      "additionalProperties": false,
      "properties": {
        "ground": { "$ref": "#/definitions/hex" },
        "ink": { "$ref": "#/definitions/hex" },
        "accent": { "$ref": "#/definitions/hex" },
        "secondary": { "$ref": "#/definitions/hex" },
        "coverage": {
          "type": "object",
          "description": "Target cakupan area pada dunia ilustrasi, persen. Dipakai untuk cek frame kunci.",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 },
          "examples": [{ "ground": 55, "ink": 20, "secondary": 18, "accent": 7 }]
        }
      }
    },
    "typography": {
      "type": "object",
      "required": ["display", "body", "captions"],
      "additionalProperties": false,
      "properties": {
        "display": { "$ref": "#/definitions/font" },
        "body": { "$ref": "#/definitions/font" },
        "captions": { "$ref": "#/definitions/font" }
      }
    },
    "safe_area": {
      "type": "object",
      "description": "Kotak aman teks dalam piksel kanvas 1080x1920.",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "rules": {
      "type": "object",
      "description": "Aturan visual terukur yang dicek di frame kunci.",
      "additionalProperties": false,
      "properties": {
        "max_words_per_line": { "type": "integer", "minimum": 1, "default": 5 },
        "min_credit_px": { "type": "integer", "minimum": 1, "default": 30 },
        "min_motion_change_s": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "max_motion_change_s": { "type": "number", "exclusiveMinimum": 0, "default": 2 },
        "end_card_hold_s": { "type": "number", "minimum": 0, "default": 8 },
        "min_contrast_ratio": { "type": "number", "minimum": 1, "default": 4.5 }
      }
    },
    "fonts": {
      "type": "array",
      "description": "Font yang dibundel di episode; path relatif terhadap folder episode.",
      "items": {
        "type": "object",
        "required": ["family", "file", "license"],
        "additionalProperties": false,
        "properties": {
          "family": { "type": "string" },
          "file": { "type": "string" },
          "weight": { "type": "integer" },
          "license": { "type": "string", "description": "SPDX atau nama lisensi, mis. OFL-1.1" }
        }
      },
      "default": []
    },
    "banned": {
      "type": "array",
      "description": "Pola yang dilarang di episode ini. Dipakai sebagai checklist review, bukan pengecek otomatis.",
      "items": { "type": "string", "minLength": 3 },
      "minItems": 1
    }
  },
  "definitions": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "font": {
      "type": "object",
      "required": ["family", "weight"],
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 },
        "size_px": { "type": "integer", "minimum": 20 },
        "line_height": { "type": "number", "minimum": 0.8, "maximum": 2 }
      }
    }
  }
}
