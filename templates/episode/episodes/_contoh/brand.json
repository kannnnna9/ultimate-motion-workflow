{
  "version": 1,
  "episode": "_contoh",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "codec": "h264",
    "audio_codec": "aac",
    "pixel_aspect": "1:1",
    "color_space": "bt709"
  },
  "palette": {
    "ground": "#B8D2C4",
    "ink": "#203A36",
    "accent": "#D27D62",
    "secondary": "#6D956B",
    "coverage": { "ground": 55, "ink": 20, "secondary": 18, "accent": 7 }
  },
  "typography": {
    "display": { "family": "Archivo Black", "weight": 900, "size_px": 88, "line_height": 1.05 },
    "body": { "family": "Space Mono", "weight": 400, "size_px": 44, "line_height": 1.3 },
    "captions": { "family": "DejaVu Sans", "weight": 700, "size_px": 56, "line_height": 1.2 }
  },
  "safe_area": { "x": 120, "y": 288, "width": 660, "height": 960 },
  "rules": {
    "max_words_per_line": 5,
    "min_credit_px": 30,
    "min_motion_change_s": 1,
    "max_motion_change_s": 2,
    "end_card_hold_s": 8,
    "min_contrast_ratio": 4.5
  },
  "fonts": [],
  "banned": [
    "static slide cards",
    "repeated scene-title frames",
    "pill labels",
    "dotted progress bars",
    "generic floating icons",
    "full-screen fade or slide-up entrances",
    "random particles",
    "CSS image filters",
    "microtext below 30 px",
    "any sound over the final source card"
  ]
}
