# Salin ke .env lalu isi nilainya. .env tidak pernah masuk Git.

# --- HyperFrames (pinned 0.9.72) ---
HYPERFRAMES_VERSION=0.9.72
HYPERFRAMES_CACHE_DIR=$HOME/.hermes/hyperframes-cache

# Worker render: 2 vCPU di VM ini, jangan naikkan tanpa cek RAM/disk.
HYPERFRAMES_WORKERS=1

# --- Voice over ---
# edge  = Edge TTS (gratis, butuh jaringan)
# local = file VO eksternal + transkripsi faster-whisper
VO_ENGINE=edge
VO_VOICE=id-ID-GadisNeural
VO_RATE=+0%

# --- Caption ---
# faster-whisper small untuk transkrip VO lokal; tidak perlu API key.
CAPTION_ENGINE=faster-whisper
CAPTION_MODEL=small
CAPTION_LANGUAGE=id

# --- Output ---
# Direktori hasil render; di-ignore Git. Boleh absolut.
OUTPUT_DIR=out/
PREVIEW_SCALE=0.5
FINAL_FPS=30
FINAL_SIZE=1080x1920

# --- Opsional ---
# Hanya diisi kalau memakai TTS berbayar. Kosongkan untuk alur tanpa API key.
# TTS_API_KEY=
